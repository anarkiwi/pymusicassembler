// Music Assembler song streams, as the editor stores them and the play
// routine reads them.
//
// Each stream is the run of bytes one of the player's 8-bit cursors walks from
// a pointer-table entry: a pattern (pattern_lo/pattern_hi), a voice's
// orderlist (order_lo/order_hi) or an arpeggio program (inner_lo/inner_hi).
// Input is one character per byte (latin-1). A stream ends at its terminator;
// the bytes stored after it (_TAIL) are never read through that pointer.
// Start rules suffixed with a build name accept that build's extra commands.

// ---------------------------------------------------------------------------
// Pattern: rows until an $FF at a row start. Every row sets a duration d (its
// byte & $1F) and lasts d + 1 tempo ticks. The player reads a row before
// testing for $FF, so an empty pattern (a bare $FF) plays that $FF as a hold
// (duration $1F) and walks on into the following bytes: its rows run to the
// next row-start $FF.

pattern: row+ PATTERN_END _TAIL?
       | PATTERN_END row* PATTERN_END _TAIL? -> read_on

?row: note | rest | hold | select

// pitch (+ orderlist transpose) indexes the note-frequency tables; the control
// byte's low five bits are the row's duration, bit 6 ties the note (no
// instrument retrigger), bit 5 runs the vibrato and stops the instrument's
// flag-$10 frequency sweep (a wave program still runs). Bit 7 takes the
// filter sweep to this voice (bit 5 then keeps the previous vibrato steps).
note: NOTE (plain | vibrato | filter)
plain: CONTROL
vibrato: CONTROL_VIBRATO BYTE BYTE  // frequency step lo, hi per frame
// cutoff the voice's trigger loads (low nibble n: sweep step 2n - 16), then
// sweep length (frames; 0 keeps the previous length and routes no voice)
filter: CONTROL_FILTER BYTE BYTE

rest: REST    // gate off
hold: HOLD    // the sounding note continues

// an instrument select sets the voice's instrument from this row on; it is
// followed by a note, or by any byte from $60 as a rest (gate off)
select: INSTRUMENT (note | select_rest)
select_rest: SELECT_REST

NOTE: /[\x00-\x5f]/
REST: /[\x60-\x7f]/
INSTRUMENT: /[\x80-\x9f]/
HOLD: /[\xa0-\xfe]/
PATTERN_END: /\xff/
SELECT_REST: /[\x60-\xff]/
CONTROL: /[\x00-\x1f\x40-\x5f]/
CONTROL_VIBRATO: /[\x20-\x3f\x60-\x7f]/
CONTROL_FILTER: /[\x80-\xff]/

// ---------------------------------------------------------------------------
// Orderlist: (pattern id, transpose << 4 | repeat) entries, read by the
// orderlist step when a pattern's repeats run out. $FF loops to the build's
// restart entry; a single $FE parks the voice on the silence pattern. The
// order-hook build adds the $FD n jump to entry n, the later build also the
// $FC t tempo reload, applied before the step reads the next entry.

orderlist: entry* order_end _TAIL?
orderlist_hook: entry_hook* (order_end | jump) _TAIL?
orderlist_inline: (entry_inline | tempo)* (order_end | jump) _TAIL?

entry: PATTERN BYTE
entry_hook: PATTERN_HOOK BYTE -> entry
entry_inline: PATTERN_INLINE BYTE -> entry
tempo: ORDER_TEMPO BYTE
jump: ORDER_JUMP BYTE
?order_end: loop | silence
loop: ORDER_LOOP
silence: SILENCE

PATTERN: /[\x00-\xfd]/
PATTERN_HOOK: /[\x00-\xfc]/
PATTERN_INLINE: /[\x00-\xfb]/
ORDER_TEMPO: /\xfc/
ORDER_JUMP: /\xfd/
SILENCE: /\xfe/
ORDER_LOOP: /\xff/

// ---------------------------------------------------------------------------
// Arpeggio (wave) program, run each frame for an instrument whose flags' low
// nibble n selects slot n (n = 0 runs none): (waveform, pitch, cutoff) rows.
// The pitch is relative to the note (absolute from $80 on builds that test
// bit 7); a non-zero cutoff replaces the filter sweep's cutoff accumulator. A
// row-start $FF restarts the program, $FE stops it; the later build's $FD r
// continues at byte 3r, so r = 0 or r at least the marker's offset restarts
// and r from the row count on runs into the bytes past the program.

program: program_row* program_end _TAIL?
program_jump: program_row_jump* (program_end | row_jump) _TAIL?

program_row: WAVE BYTE BYTE
program_row_jump: WAVE_JUMP BYTE BYTE -> program_row
row_jump: PROGRAM_JUMP BYTE
?program_end: stop | restart
stop: PROGRAM_STOP
restart: PROGRAM_RESTART

WAVE: /[\x00-\xfd]/
WAVE_JUMP: /[\x00-\xfc]/
PROGRAM_JUMP: /\xfd/
PROGRAM_STOP: /\xfe/
PROGRAM_RESTART: /\xff/

// ---------------------------------------------------------------------------

%import bytes (BYTE, _TAIL)
